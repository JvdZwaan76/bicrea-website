# Cloudflare Pages: Headers configuration
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Pages publishes the repository root as-is (no build output directory is set),
# so CSS/JS are served at their plain names and are not content-hashed.
# They get a short cache with revalidation; images and favicons are
# content-named and cached long. The /assets/* rule is kept for the day the
# build output directory is switched to dist/ (hashed filenames).
#
# Cloudflare joins duplicate headers with a comma, so Cache-Control is set
# once per path category and never on /*.

# ---------------------------------------------------------------------------
# Security baseline (all routes)
# ---------------------------------------------------------------------------
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests;

# ---------------------------------------------------------------------------
# Content-hashed assets (only present once the dist/ build is published)
# ---------------------------------------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# HTML pages — short cache, always revalidate
# (.html URLs 301 to these extensionless paths, so the rules live here)
# ---------------------------------------------------------------------------
/
  Cache-Control: public, max-age=300, must-revalidate
/title-services
  Cache-Control: public, max-age=300, must-revalidate
/methodology
  Cache-Control: public, max-age=300, must-revalidate
/distressed-properties
  Cache-Control: public, max-age=300, must-revalidate
/about
  Cache-Control: public, max-age=300, must-revalidate
/contact
  Cache-Control: public, max-age=300, must-revalidate
/faq
  Cache-Control: public, max-age=300, must-revalidate
/disclosures
  Cache-Control: public, max-age=300, must-revalidate
/privacy
  Cache-Control: public, max-age=300, must-revalidate
/terms
  Cache-Control: public, max-age=300, must-revalidate
/404.html
  Cache-Control: public, max-age=300, must-revalidate

# ---------------------------------------------------------------------------
# Unhashed CSS/JS — one hour, revalidate
# ---------------------------------------------------------------------------
/*.css
  Cache-Control: public, max-age=3600, must-revalidate
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# ---------------------------------------------------------------------------
# Images and favicons — content-named, cache long
# ---------------------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=31536000, immutable
/favicon/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=604800

# ---------------------------------------------------------------------------
# Operational files
# ---------------------------------------------------------------------------
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/humans.txt
  Cache-Control: public, max-age=86400
/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# ---------------------------------------------------------------------------
# Staff area (Cloudflare Access in front) and parked pages
# ---------------------------------------------------------------------------
/team/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store
/team/files/*
  Content-Disposition: attachment
/welcome
  X-Robots-Tag: noindex, nofollow
/under-development
  X-Robots-Tag: noindex, nofollow
